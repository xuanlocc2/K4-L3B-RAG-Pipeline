# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | groq | gemini | anthropic
#   - openai    : OpenAI chính thức (OPENAI_API_KEY, model mặc định gpt-4o-mini)
#   - groq      : Groq Cloud, OpenAI-compatible (GROQ_API_KEY, model mặc định qwen/qwen3.8-27b)
#   - gemini    : Google Gemini (GEMINI_API_KEY, model mặc định gemini-2.0-flash)
#   - anthropic : Anthropic Claude (ANTHROPIC_API_KEY, model mặc định claude-3.5-haiku)
LLM_PROVIDER=openai
LLM_MODEL=

# Generation providers (chỉ cần provider bạn chọn ở LLM_PROVIDER)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=

# Bonus 1 — Weighted RRF (xem reports/BONUS_IMPLEMENTATION.md)
# dense_weight >= bm25_weight cho kết quả ổn định trên corpus hiện tại.
DENSE_WEIGHT=1.5
BM25_WEIGHT=1.0
